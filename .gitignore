# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Database
#
# Unanchored on purpose. `data/*.db` only matches the repo-root data/, so when
# a refactor moved the connection module one directory deeper and it created
# server/data/, a 425 KB SQLite file was committed without anything objecting.
# A SQLite file should never be committed from anywhere in this tree.
**/*.db
**/*.db-wal
**/*.db-shm

# Admin store (runtime state)
data/*.json

# Environment
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backups
*.bak
backups/
.layout-qa/

# Compiled game engine (generated by `npm run build:engine`)
#
# tsconfig.engine.json lists only src/game.ts as a root, but tsc emits every
# module that file imports, one .js per source module, into server/. So this
# list grows whenever the engine gains a module — and it has to be by name,
# because server/ also holds hand-written code that must stay tracked.
#
# Get this wrong and a generated file gets committed, then drifts from its
# source until someone edits the copy and wonders why nothing happens.
server/game.js
server/ai.js
