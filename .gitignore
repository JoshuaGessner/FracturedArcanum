lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Database
#
# Unanchored on purpose. `data/*.db` only matches the repo-root data/, so when
# a refactor moved the connection module one directory deeper and it created
# server/data/, a 425 KB SQLite file was committed without anything objecting.
# A SQLite file should never be committed from anywhere in this tree.
**/*.db
**/*.db-wal
**/*.db-shm

# Admin store (runtime state)
data/*.json

# Environment
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backups
*.bak
backups/
.layout-qa/

# Compiled game engine (generated from src/game.ts)
server/game.js
